geom_tiplab(offset = 0.02, align = TRUE, linetype = "dotted") +        # tip labels
geom_tippoint(size = 3, shape = 21, fill = "red", colour = "black") +  # highlight tips
ggtitle("Tips highlighted")
tips_plot
