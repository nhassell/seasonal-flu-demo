query <- dbGetQuery(impala, glue('
WITH
-- this CTE is used for all the pipelines
base AS (
SELECT DISTINCT
isolate_hash,
CASE
WHEN I.is_reference = 0 THEN "virus"
WHEN I.is_reference = 1 THEN "reference"
ELSE NULL
END AS sample_type
FROM gaa.isolate_view_tbl as I
),
A as (
SELECT * FROM
(
SELECT dense_rank() over(PARTITION BY isolate_hash, reference_id, protein ORDER BY
version DESC,
flu_sequence_id) version_rank,
*
FROM gaa.alignments_rough_merge_all
) R
WHERE R.version_rank = 1
)
SELECT DISTINCT
REGEXP_REPLACE(
CONCAT(REGEXP_REPLACE(N.isolate_name, "{my_regex}", ""), "_", SUBSTRING(N.isolate_hash, 1, 10)),
"{my_regex2}", "_") AS strain,
N.isolate_hash,
N.epi_isolate_id,
N.subtype AS virus,
CAST(N.collection_date AS DATE) collection_date,
CAST(N.internal_date AS DATE) internal_date,
ABS(FLOOR(DATEDIFF(N.internal_date,current_date())/7)) AS relative_added_week,
CASE
WHEN N.country_iso IS NULL AND sample_type = "reference" THEN ""
WHEN N.country_iso IS NULL AND sample_type = "virus" THEN "NAM"
ELSE N.country_iso
END AS country,
N.isl_ha_genetic_group AS HA_genetic_group,
N.short_clade,
N.ha_subclade AS ha_subclade,
N.na_subclade AS na_subclade,
N.ha_subclade_ref_aa_diff AS ha_subclade_aa_diff,
N.na_subclade_ref_aa_diff AS na_subclade_aa_diff,
N.passage_standard AS passage,
N.reason_for_submission AS reason,
N.data_source AS source,
N.cdc_id AS CDC_ID,
COALESCE(N.submitter_institution_id, "Not-Listed") AS submitter,
COALESCE(REGEXP_REPLACE(N.originating_lab, "{my_regex}", ""), "Not-Listed") AS originator,
G.genome_aln AS sequence,
A.cds_id,
A.variant_hash,
IR.sample_type,
A.segment,
G.ctype,
A.protein,
H.hhs_region,
I.us_states_territories_abbv
FROM
network_tree.cds_genetic_strains_subset as N
INNER JOIN A
ON
N.isolate_hash = A.isolate_hash
LEFT JOIN
base AS IR
ON
N.isolate_hash = IR.isolate_hash
LEFT JOIN
gaa.isolate_standard_rank as R
ON
N.isolate_hash = R.isolate_hash
LEFT JOIN
gaa.isolate_view_tbl I
ON
N.isolate_hash = I.isolate_hash
LEFT JOIN
gaa.us_states_territories H
ON
I.us_states_territories_abbv = H.us_states_territories_abbv
LEFT ANTI JOIN
gaa.blacklist AS B
ON
N.isolate_hash = B.isolate_hash
LEFT JOIN
sand.genome_alignments G
ON
A.nt_id = G.nt_id
LEFT JOIN
qualsys.sand_segment_qc AS q
ON
N.nt_id = q.nt_id
WHERE
(
(regexp_like(N.isl_ha_type, "^H3$|,H3") AND
(N.isolate_hash != "5c38c85eca5d137d72385cb3c65826fc" AND A.reference_id = "HK4801"))
OR
((regexp_like(N.isl_ha_type, "^H1$|H1,") AND A.segment IN ("HA","NA")) AND
(N.isolate_hash != "cc5c4bbed5b7e37482bc468337e4449e" AND A.reference_id = "CALI07"))
OR
((regexp_like(N.isl_ha_type, "^H1$|H1,") AND A.segment NOT IN ("HA","NA"))  AND
(N.isolate_hash != "cc5c4bbed5b7e37482bc468337e4449e" AND A.reference_id = "HK4801"))
OR
((N.isl_ha_genetic_group LIKE "V%%" AND A.segment IN ("HA", "NS")) AND
(A.reference_id = "BRISBANE60" AND N.isolate_hash != "ccffb6a5f99045c936ec0e4f3d27594d"))
OR
((N.isl_ha_genetic_group LIKE "V%%" AND A.segment NOT IN ("HA", "NS")) AND
(A.reference_id = "PHUKET3073" AND N.isolate_hash != "ccffb6a5f99045c936ec0e4f3d27594d"))
)
AND
N.host_generic = "human"
AND
G.genome_aln IS NOT NULL
AND
N.lab_generated = FALSE
AND
((R.gaa_original_ranking = 1
AND
q.pass_qc = TRUE
AND
regexp_like(N.reason_for_submission, "^surveillance|ES-1|^vaccine effectiveness|^isc surveillance|^nirc surveillance"))
OR
((N.is_reference = TRUE AND regexp_like(N.isl_ha_type, "^H1$|H1,|^H3$|,H3") AND regexp_like(N.isl_ha_genetic_group, "6B\\\\.1|3C\\\\."))
OR
(N.is_reference = TRUE AND N.isl_ha_genetic_group LIKE "V%%" AND N.isl_ha_genetic_group LIKE "V%%"))
)
AND A.protein in ("HA","NA","PB1","PB2","PA","NP","M1","NS1")
'))
