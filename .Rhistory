library(treeio)
library(ggtree)
tree_text <- "((A:1,B:1,(C:0.5,D:0.5):0.5):0.5,E:1);"
tree <- read.tree(text = tree_text)
ggtree(tree)
tree <- root.phylo(tree, "A")
ggtree(tree)
ggtree(tree, branch.length = "branch.length") + theme_tree2()
plot(tree)
tree_text <- "((A:1,B:1,(C:0.5,D:0.5):0.5):0.5,E:1);"
tree <- read.tree(text = tree_text)
plot(tree)
tree <- root.phylo(tree, "E")
plot(tree)
tree_text <- "((A:1,B:1.5,(C:0.5,D:0.5):0.5):0.5,E:1);"
tree <- read.tree(text = tree_text)
tree <- root.phylo(tree, "E")
