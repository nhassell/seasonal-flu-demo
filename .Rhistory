tree_text <- "((A:1,B:1.5,(C:0.75,D:0.5):0.5):0.5,E:1);"
tree <- read.tree(text = tree_text)
tree <- root.phylo(tree, "E")
plot(tree)
tree_text <- "((A:0.75,B:1.0,(C:0.75,D:0.5):0.5):0.5,E:1);"
tree <- read.tree(text = tree_text)
tree <- root.phylo(tree, "E")
plot(tree)
